#!/usr/bin/env php
<?php

declare(strict_types=1);

use DataMachineCode\Workspace\StandaloneWorktreeProvider;

define('DATAMACHINE_CODE_STANDALONE', true);
require dirname(__DIR__) . '/vendor/autoload.php';

$operation = (string) ( $argv[1] ?? '' );
$workspace = (string) ( $argv[2] ?? '' );
$value     = (string) ( $argv[3] ?? '' );
$base_sha  = (string) ( $argv[4] ?? '' );

if ( ! in_array($operation, array( 'capabilities', 'identity', 'task', 'safety', 'converge' ), true) || ( 'capabilities' !== $operation && ( '' === $workspace || '' === $value ) ) || ( 'converge' === $operation && '' === $base_sha ) ) {
	fwrite(STDERR, "Usage: dmc-worktree-provider capabilities | <identity|task|safety|converge> <workspace-root> <handle|task-url|identity-token> [base-sha]\n");
	exit(2);
}

$provider = new StandaloneWorktreeProvider();
$result   = match ( $operation ) {
	'capabilities' => $provider->capabilities(),
	'identity' => $provider->resolve_identity($workspace, $value),
	'task' => $provider->resolve_task($workspace, $value),
	'safety' => $provider->attest_safety($workspace, $value),
	'converge' => $provider->converge($workspace, $value, $base_sha),
};

fwrite(STDOUT, json_encode($result, JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n");
exit('error' === ( $result['status'] ?? '' ) ? 1 : 0);
